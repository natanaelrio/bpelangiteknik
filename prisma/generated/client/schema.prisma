generator client {
  provider        = "prisma-client-js"
  output          = "./generated/client"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categoryProductUtama {
  id              Int               @id @default(autoincrement())
  start           DateTime          @default(now())
  end             DateTime          @updatedAt
  category        String            @unique
  slugCategory    String            @unique
  image           String?
  icon            String?
  urlYoutube      String?
  title           String?
  desc            String?
  tags            String?
  categoryProduct categoryProduct[]
}

model categoryProduct {
  id                     Int                   @id @default(autoincrement())
  start                  DateTime              @default(now())
  end                    DateTime              @updatedAt
  category               String                @unique
  slugCategory           String                @unique
  image                  String?
  icon                   String?
  urlYoutube             String?
  title                  String?
  desc                   String?
  tags                   String?
  categoryProductUtamaId Int?
  categoryProductUtama   categoryProductUtama? @relation(fields: [categoryProductUtamaId], references: [id])
  listProducts           listProduct[]

  @@index([categoryProductUtamaId])
}

model listProduct {
  id                 Int                @id @default(autoincrement())
  start              DateTime           @default(now())
  end                DateTime           @updatedAt
  slugProduct        String             @unique
  saveDraf           Boolean            @default(true)
  descProduct        String?
  productName        String?
  stockProduct       Int?
  descMetaProduct    String?
  viewProduct        Int?               @default(1)
  subKategoriProduct String?
  productType        String?
  tagProduct         String?
  productPrice       BigInt?
  productDiscount    Int?
  productPriceFinal  BigInt?
  urlYoutube         String?
  productKategori    Int
  sold               Int?               @default(0)
  username           String?
  spekNew            Json?
  weightProduct      Int?
  heightProduct      Int?
  lengthProduct      Int?
  widthProduct       Int?
  updateDate         DateTime           @default(now())
  cartItem           cartItem[]
  url_image_product  imageProduct[]
  imageProductUtama  imageProductUtama?
  user               categoryProduct    @relation(fields: [productKategori], references: [id])
  spec_product       specProduct?
  relatedArticles    postArtikel[]      @relation("ArtikelProduk")
  fMerek             fMerek[]           @relation("FMerek")

  @@index([productKategori])
}

model fMerek {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  Merek     listProduct[] @relation("FMerek")
}

model specProduct {
  id                   Int         @id @default(autoincrement())
  start                DateTime    @default(now())
  end                  DateTime    @updatedAt
  phase_spec           String?
  frequency_spec       String?
  gensetPower_spec     String?
  ratedPower_spec      String?
  maxPower_spec        String?
  ratedACVoltage_spec  String?
  starting_spec        String?
  fuelConsumption_spec String?
  weight_spec          Int?
  dimension_spec       String?
  IdProduct            Int         @unique
  user                 listProduct @relation(fields: [IdProduct], references: [id])
}

model imageProductUtama {
  id                Int         @id @default(autoincrement())
  start             DateTime    @default(now())
  end               DateTime    @updatedAt
  asset_id          String?     @unique
  public_id         String?     @unique
  version           Int?
  version_id        String?
  signature         String?
  width             Int?
  height            Int?
  format            String?
  resource_type     String?
  created_at        DateTime    @default(now())
  pages             Int?
  tags              Json?
  bytes             Int?
  type              String?
  etag              String?
  placeholder       Boolean?
  url               String?
  secure_url        String?
  asset_folder      String?
  display_name      String?
  original_filename String?
  api_key           String?
  overwritten       Boolean?
  IdProduct         Int         @unique
  user              listProduct @relation(fields: [IdProduct], references: [id])
}

model imageProduct {
  id                Int         @id @default(autoincrement())
  start             DateTime    @default(now())
  end               DateTime    @updatedAt
  asset_id          String?     @unique
  public_id         String?     @unique
  version           Int?
  version_id        String?
  signature         String?
  width             Int?
  height            Int?
  format            String?
  resource_type     String?
  created_at        DateTime    @default(now())
  pages             Int?
  tags              Json?
  bytes             Int?
  type              String?
  etag              String?
  placeholder       Boolean?
  url               String?
  secure_url        String?
  asset_folder      String?
  display_name      String?
  original_filename String?
  api_key           String?
  overwritten       Boolean?
  IdProduct         Int
  user              listProduct @relation(fields: [IdProduct], references: [id])

  @@index([IdProduct])
}

model voucher {
  id        String   @id @default(uuid())
  kode      String   @unique
  diskon    Int
  expiredAt DateTime
  nominal   BigInt?
  tipe      String?
  harga     BigInt?
  carts     cart[]
}

model cart {
  IDCart      String         @id
  email       String         @unique
  name        String?
  avatar      String?
  id          Int            @default(autoincrement())
  start       DateTime       @default(now())
  end         DateTime?      @updatedAt
  voucherId   String?
  voucher     voucher?       @relation(fields: [voucherId], references: [id])
  items       cartItem[]
  dataPesanan dataPesanan[]
  formData    formPembelian?
  ongkosKirim ongkosKirim?
}

model cartItem {
  id        Int         @id @default(autoincrement())
  start     DateTime    @default(now())
  end       DateTime?   @updatedAt
  cartId    String
  productId Int
  quantity  Int         @default(1)
  checkList Boolean     @default(false)
  note      String?
  cart      cart        @relation(fields: [cartId], references: [IDCart], onDelete: Cascade)
  product   listProduct @relation(fields: [productId], references: [id])
}

model formPembelian {
  id                  Int       @id @default(autoincrement())
  start               DateTime  @default(now())
  end                 DateTime? @updatedAt
  nama_lengkap_user   String?   @db.VarChar(200)
  alamat_lengkap_user String?   @db.VarChar(200)
  kode_pos_user       Int?
  no_hp_user          BigInt?
  catatan_pengiriman  String?   @db.VarChar(200)
  cartID              String    @unique
  city                String?   @db.VarChar(200)
  province            String?   @db.VarChar(200)
  alamat_detail       String?
  user                cart      @relation(fields: [cartID], references: [IDCart])
}

model ongkosKirim {
  id          Int       @id @default(autoincrement())
  start       DateTime  @default(now())
  end         DateTime? @updatedAt
  productName String?
  price       BigInt?
  quantity    Int?
  cartID      String    @unique
  user        cart      @relation(fields: [cartID], references: [IDCart])
}

model dataPesananItem {
  id              Int          @id @default(autoincrement())
  start           DateTime     @default(now())
  end             DateTime?    @updatedAt
  note            String?
  productName     String?
  price           BigInt?
  priceOriginal   BigInt?
  quantity        Int?
  methodPayment   String?
  image           String?
  slugProduct     String?
  merchantOrderId String?
  status          String?
  noResi          String?
  dataPesananId   Int?
  dataPesanan     dataPesanan? @relation(fields: [dataPesananId], references: [id])
}

model dataPesanan {
  id                  Int               @id @default(autoincrement())
  start               DateTime          @default(now())
  end                 DateTime?         @updatedAt
  payment             Boolean?          @default(false)
  reference           String            @unique
  merchantOrderId     String            @unique
  cartID              String
  alamat_lengkap_user String?           @db.VarChar(200)
  catatan_pengiriman  String?           @db.VarChar(200)
  kode_pos_user       Int?
  nama_lengkap_user   String?           @db.VarChar(200)
  no_hp_user          BigInt?
  diskon              Int?
  kode                String?           @db.VarChar(200)
  alamat_detail       String?
  nota_url            String?           @db.VarChar(200)
  payment_info        String?
  diskon_nominal      BigInt?
  cart                cart              @relation(fields: [cartID], references: [IDCart])
  dataPesananItems    dataPesananItem[]

  @@index([cartID, kode, reference])
}

model suratPenawaran {
  id          String    @id @default(uuid())
  start       DateTime  @default(now())
  end         DateTime? @updatedAt
  name        String?
  email       String?
  noHP        BigInt?
  nameProduct String?
  note        String?
  slugProduct String?
  sales       String?
}

model postArtikel {
  id                  Int                   @id @default(autoincrement())
  title               String
  slug                String                @unique
  viewArtikel         Int?                  @default(1)
  content             String
  description         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  saveDraf            Boolean?              @default(true)
  categoryArtikelId   Int
  end                 DateTime              @updatedAt
  start               DateTime              @default(now())
  imageProductArtikel imageProductArtikel[]
  categoryArtikel     categoryArtikel       @relation(fields: [categoryArtikelId], references: [id])
  tagsArtikel         tagArtikel[]          @relation("ArticleTags")
  relatedProducts     listProduct[]         @relation("ArtikelProduk")
}

model tagArtikel {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  articles  postArtikel[] @relation("ArticleTags")
}

model imageProductArtikel {
  id                Int         @id @default(autoincrement())
  start             DateTime    @default(now())
  end               DateTime    @updatedAt
  asset_id          String?     @unique
  public_id         String?     @unique
  version           Int?
  version_id        String?
  signature         String?
  width             Int?
  height            Int?
  format            String?
  resource_type     String?
  created_at        DateTime    @default(now())
  pages             Int?
  tags              Json?
  bytes             Int?
  type              String?
  etag              String?
  placeholder       Boolean?
  url               String?
  secure_url        String?
  asset_folder      String?
  display_name      String?
  original_filename String?
  api_key           String?
  overwritten       Boolean?
  IdProductArtikel  Int
  userd             postArtikel @relation(fields: [IdProductArtikel], references: [id])

  @@index([IdProductArtikel])
}

model categoryArtikel {
  id           Int           @id @default(autoincrement())
  start        DateTime      @default(now())
  end          DateTime      @updatedAt
  category     String        @unique
  slugCategory String        @unique
  image        String?
  icon         String?
  urlYoutube   String?
  title        String?
  desc         String?
  tags         String?
  postArtikel  postArtikel[]
}

model sales {
  id             String   @id @default(uuid())
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  numberForm     String   @unique
  numberWA       String   @unique
  clickCountForm Int      @default(0)
  clickCountWA   Int      @default(0)
}
